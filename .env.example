BOOTSTRAP_OWNER_EMAIL=
# El build de producción publica la tienda, el POS y Administración protegidos.
FRAGUAN_SURFACE=business
# Mantener cerrado el acceso público a POS y Administración.
FRAGUAN_STAFF_OPEN_ACCESS=false
# Origen HTTPS de la API Railway: solo en Vercel, dejar vacío en Railway/local.
FRAGUAN_API_ORIGIN=
DATABASE_URL=
DATABASE_POOL_SIZE=10
# En local se usa 197313 si queda vacío. En producción ambos son obligatorios.
ADMIN_PIN=
ADMIN_SESSION_SECRET=
# Solo habilitar detrás de un proxy que firme y elimine encabezados externos.
INTERNAL_AUTH_TRUST_PROXY=false
# Mantener deshabilitado al migrar las cuentas públicas a Google Auth.
STORE_PASSWORD_AUTH_ENABLED=false
SITE_ORIGIN=
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# OAuth del personal: separado del login público de clientes.
INTERNAL_AUTH_MODE=google
INTERNAL_GOOGLE_CLIENT_ID=
INTERNAL_SESSION_SECRET=
# Contraseña del propietario: hash generado con scripts/configure-staff-access.ps1.
# Nunca guardar la contraseña original; no habilita a otros usuarios.
INTERNAL_PASSWORD_HASH=
STORE_LEGAL_NAME=
STORE_CUIT=
STORE_ADDRESS=
STORE_SUPPORT_EMAIL=
STORE_SUPPORT_PHONE=
# Se muestran al cliente únicamente después de crear un pedido por transferencia.
TRANSFER_ACCOUNT_HOLDER=
TRANSFER_ACCOUNT_TAX_ID=
TRANSFER_BANK=
TRANSFER_ALIAS=
TRANSFER_CBU_CVU=
ONLINE_PAYMENT_WEBHOOK_SECRET=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=FRAGUAN <pedidos@fraguan.com>
RESEND_VERIFICATION_FROM=FRAGUAN <noreply@fraguan.com>
RESEND_MARKETING_FROM=FRAGUAN <hola@fraguan.com>
RESEND_ORDER_TO=
STORE_EMAIL_VERIFICATION_SECRET=
# El programador del runtime definitivo ejecutará las automatizaciones preparadas.
CORREO_API_URL=https://apitest.correoargentino.com.ar/micorreo/v1
CORREO_API_USER=
CORREO_API_PASSWORD=
CORREO_CUSTOMER_ID=
CORREO_ORIGIN_POSTAL_CODE=
